# Supabase → Project Settings → API Keys
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
# publishable key (sb_publishable_...) ใช้ในเบราว์เซอร์สำหรับ Realtime เท่านั้น
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# secret key (sb_secret_...) ใช้ฝั่ง server เท่านั้น ห้ามใส่ NEXT_PUBLIC_
SUPABASE_SECRET_KEY=
